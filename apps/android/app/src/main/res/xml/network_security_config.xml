<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- NetControl prefers HTTPS. Cleartext is permitted so a service on the
         local LAN can be reached during setup; the app warns about it. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
