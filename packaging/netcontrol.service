[Unit]
Description=NetControl network discovery, monitoring and access management
After=network-online.target
Wants=network-online.target
Documentation=https://example.invalid/netcontrol

[Service]
Type=simple
User=netcontrol
Group=netcontrol
Environment=NETCONTROL_HOME=/var/lib/netcontrol
Environment=RUST_LOG=info
WorkingDirectory=/var/lib/netcontrol
ExecStart=/usr/bin/netcontrol serve
Restart=on-failure
RestartSec=3

# The daemon runs unprivileged. Enforcement goes through the narrow
# netcontrol-helper allowlist installed at /usr/lib/netcontrol/netcontrol-helper.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ReadWritePaths=/var/lib/netcontrol
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
